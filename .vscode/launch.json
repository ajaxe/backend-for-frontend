{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BFF-Proxy",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-proxy",
      "program": "${workspaceFolder}/src/ApogeeDev.Bff.Yarp.Host/bin/Debug/net10.0/ApogeeDev.Bff.Yarp.Host.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ApogeeDev.Bff.Yarp.Host",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\"address\":\"(https?://[^\"]+)\"",
        "uriFormat": "%s/api/profile"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "BFF-Upstream",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-upstream",
      "program": "${workspaceFolder}/src/ApogeeDev.Sample.Backend.Host/bin/Debug/net10.0/ApogeeDev.Sample.Backend.Host.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ApogeeDev.Sample.Backend.Host",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/api/profile"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5065"
      }
    }
  ],
  "compounds": [
    {
      "name": "Test-Stack",
      "configurations": ["BFF-Proxy", "BFF-Upstream"]
    }
  ]
}
